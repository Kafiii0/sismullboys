{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BIFROST Witness Cam",
  "version": "1.0.0",
  "identifier": "com.bifrost.witnesscam",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000/witness-desktop",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node ./scripts/prepare-tauri-build.js"
  },
  "app": {
    "windows": [
      {
        "title": "BIFROST Witness Cam",
        "width": 1200,
        "height": 780,
        "minWidth": 1050,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/witness_engine/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
